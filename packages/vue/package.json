{
  "name": "@fos-icons/vue",
  "version": "0.3.0",
  "description": "Fos Icons' four-style SVG icon library as typed Vue 3 components.",
  "keywords": [
    "fos-icons",
    "icons",
    "svg",
    "vue",
    "vue3",
    "duotone"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./regular": {
      "import": {
        "types": "./dist/types/regular/index.d.ts",
        "default": "./dist/esm/regular/index.js"
      },
      "require": {
        "types": "./dist/types/regular/index.d.cts",
        "default": "./dist/cjs/regular/index.cjs"
      }
    },
    "./filled": {
      "import": {
        "types": "./dist/types/filled/index.d.ts",
        "default": "./dist/esm/filled/index.js"
      },
      "require": {
        "types": "./dist/types/filled/index.d.cts",
        "default": "./dist/cjs/filled/index.cjs"
      }
    },
    "./duocolor": {
      "import": {
        "types": "./dist/types/duocolor/index.d.ts",
        "default": "./dist/esm/duocolor/index.js"
      },
      "require": {
        "types": "./dist/types/duocolor/index.d.cts",
        "default": "./dist/cjs/duocolor/index.cjs"
      }
    },
    "./duotone": {
      "import": {
        "types": "./dist/types/duotone/index.d.ts",
        "default": "./dist/esm/duotone/index.js"
      },
      "require": {
        "types": "./dist/types/duotone/index.d.cts",
        "default": "./dist/cjs/duotone/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/types/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/types/*.d.cts",
        "default": "./dist/cjs/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && vue-tsc -p tests/tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fos-icons/fos-icons.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
