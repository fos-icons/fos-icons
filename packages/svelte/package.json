{
  "name": "@fos-icons/svelte",
  "version": "0.4.0",
  "description": "Fos Icons in four styles as typed, tree-shakeable Svelte 5 components.",
  "keywords": [
    "fos-icons",
    "icons",
    "svg",
    "svelte",
    "svelte5",
    "duotone"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./regular": {
      "types": "./dist/regular/index.d.ts",
      "svelte": "./dist/regular/index.js",
      "default": "./dist/regular/index.js"
    },
    "./filled": {
      "types": "./dist/filled/index.d.ts",
      "svelte": "./dist/filled/index.js",
      "default": "./dist/filled/index.js"
    },
    "./duocolor": {
      "types": "./dist/duocolor/index.d.ts",
      "svelte": "./dist/duocolor/index.js",
      "default": "./dist/duocolor/index.js"
    },
    "./duotone": {
      "types": "./dist/duotone/index.d.ts",
      "svelte": "./dist/duotone/index.js",
      "default": "./dist/duotone/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "svelte": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && svelte-check --tsconfig ./tests/tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "^0.9.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fos-icons/fos-icons.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  }
}
